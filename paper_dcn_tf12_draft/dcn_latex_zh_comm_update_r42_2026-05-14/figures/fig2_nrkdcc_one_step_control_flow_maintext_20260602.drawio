ometry"/></mxCell><mxCell id="cert_decision" value="&lt;b&gt;Certificate&lt;br&gt;passes?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;m&lt;sub&gt;k&lt;/sub&gt; ≥ -ε&lt;sub&gt;m&lt;/sub&gt;&lt;/font&gt;" style="rhombus=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D64545;strokeWidth=1.7;fontColor=#1F2937;fontSize=9;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1200" y="225" width="86" height="78" as="geometry"/></mxCell><mxCell id="plant" value="&lt;b&gt;Four-vehicle rigid-payload&lt;br&gt;system and feedback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;states, errors, forces, constraints, logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EFFB;strokeColor=#7E68A4;strokeWidth=1.6;fontColor=#1F2937;fontSize=10;align=center;verticalAlign=middle;spacing=5;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1330" y="210" width="235" height="108" as="geometry"/></mxCell><mxCell id="fallback" value="&lt;b&gt;Projection / tightening /&lt;br&gt;C3 degraded fallback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;reference contraction if needed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#D64545;strokeWidth=1.6;fontColor=#1F2937;fontSize=10;align=center;verticalAlign=middle;spacing=5;arcSize=8;" vertex="1" parent="1"><mxGeometry x="925" y="365" width="235" height="72" as="geometry"/></mxCell><mxCell id="e_ref_sum" value="" edge="1" parent="1" source="ref_input" target="sum" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.8;fontColor=#374151;fontSize=8;labelBackgroundColor=none;labelBorderColor=none;dashed=0;dashPattern=solid;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_sum_net" value="tracking error" edge="1" parent="1" source="sum" target="network" style="edgeStyle=orthogonalEdgeStyle;rounded=1