<mxfile host="app.diagrams.net" modified="2026-06-02T00:00:00.000Z" agent="Codex" version="26.0.0" type="device"><diagram id="nrkdcc-maintext-20260602" name="NR-KDCC Main-text Flow"><mxGraphModel dx="1700" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="offline" value="&lt;b&gt;Offline data and bilinear Koopman predictor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;curvature / communication / actuator-degradation data&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;input-aware robust spectral projection (IRSP)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;model, residual bound, and certificate terms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#2F6FBB;strokeWidth=1.6;fontColor=#1F2937;fontSize=10;align=center;verticalAlign=middle;spacing=5;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="52" width="1460" height="84" as="geometry"/></mxCell><mxCell id="ref_input" value="&lt;b&gt;Reference path, payload-center progress,&lt;br&gt;and temporary path packet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;p&lt;sub&gt;L&lt;/sub&gt;&lt;sup&gt;ref&lt;/sup&gt;(s), ψ&lt;sub&gt;L&lt;/sub&gt;&lt;sup&gt;ref&lt;/sup&gt;, κ&lt;sub&gt;r&lt;/sub&gt;, P&lt;sub&gt;i,k&lt;/sub&gt;&lt;sup&gt;tmp&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8FAF5;strokeColor=#15847D;strokeWidth=1.6;fontColor=#1F2937;fontSize=10;align=center;verticalAlign=middle;spacing=5;arcSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="235" height="108" as="geometry"/></mxCell><mxCell id="sum" value="Σ&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;+ / -&lt;/font&gt;" style="ellipse=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.8;fontColor=#1F29