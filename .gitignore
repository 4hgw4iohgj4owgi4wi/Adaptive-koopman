# ===========================================================================
# Adaptive-koopman：只收录代码与文本规范，不收录大体积实验产物。
#
# 原因：整树 26.19 GB / 91,839 文件，其中 .npz 13.45 GB、.csv 4.03 GB、
# .pkl 2.30 GB、.png 1.87 GB、.pdf 1.62 GB，且有 5 个文件 >100 MB
# （GitHub 单文件硬限 100 MB）。实验原始数据、模型权重与结果目录一律留在
# 本地/实验机，不进版本库。
#
# 注意：本文件只影响"是否入库"，不改变任何工作树文件字节，因此不影响
# protocol/*.json 的 SHA-256 身份校验。
# ===========================================================================

# ---------- 缓存与编辑器 ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.venv/
venv/
node_modules/

# ---------- 实验产物目录（任何层级） ----------
results/
analysis/
logs/
tmp/
archives/
saved_data/
saved_models/
datasets/
tests_tmp*/
*_results/
*_data/
offline_*/
runs/

# ---------- 历史批次与打包目录（大体积，非本项目当前代码） ----------
ALL_codehub/
A1_snapshot_*/
pinn/
专利/
专利撰写参考/
paper_ieee_sensors_*/
paper_figs_tf10/
tf1[0-9]_*/
